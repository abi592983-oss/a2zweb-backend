/**
 * A2Z website booking, ERP pull queue, and health-report Drive archive.
 *
 * Add this file to the SAME Apps Script project used to create the A2Z Google Form.
 * Run configureErpIntegration once, then deploy a new Web app version:
 * Execute as Me; access Anyone.
 *
 * Script properties used:
 * - A2Z_FORM_ID (already created by the form setup script)
 * - A2Z_ERP_SYNC_SECRET (generated by configureErpIntegration)
 * - A2Z_HEALTH_ARCHIVE_FOLDER_ID (selected by configureErpIntegration)
 */
const A2Z_PUBLIC_FORM = 'https://docs.google.com/forms/d/e/1FAIpQLSdP5et7Bd3WbQ178uMQX68hXDbsWwVEE_zAaCPb3TJFDZh3ZA/viewform';
const A2Z_SERVICES = {
  computers: 'Computer / laptop repair', cctv: 'CCTV repair', printers: 'Printer repair',
  networks: 'Networking', installation: 'CCTV installation',
  computer_health: 'Computer / laptop health check', cctv_health: 'CCTV health check'
};
const A2Z_SERVICE_BY_LABEL = Object.fromEntries(Object.entries(A2Z_SERVICES).map(([key, value]) => [value, key]));
function a2zForm_() {
  const id = PropertiesService.getScriptProperties().getProperty('A2Z_FORM_ID');
  if (!id) throw new Error('Run this in the original form-creation project; A2Z_FORM_ID is missing.');
  const form = FormApp.openById(id);
  if (form.getPublishedUrl().split('?')[0] !== A2Z_PUBLIC_FORM) throw new Error('Configured form does not match the A2Z booking form.');
  if (!form.isAcceptingResponses()) throw new Error('The booking form is not accepting responses.');
  return form;
}
function configureErpIntegration() {
  const form = a2zForm_();
  const props = PropertiesService.getScriptProperties();
  if (!props.getProperty('A2Z_ERP_SYNC_SECRET')) {
    const random = Utilities.getUuid() + Utilities.getUuid() + Utilities.getUuid();
    props.setProperty('A2Z_ERP_SYNC_SECRET', random.replace(/-/g, ''));
  }
  if (!props.getProperty('A2Z_HEALTH_ARCHIVE_FOLDER_ID')) {
    const folder = DriveApp.createFolder('A2Z Health Check JSON Archive');
    props.setProperty('A2Z_HEALTH_ARCHIVE_FOLDER_ID', folder.getId());
  }
  console.log('Connected form: ' + form.getTitle());
  console.log('ERP sync secret: ' + props.getProperty('A2Z_ERP_SYNC_SECRET'));
  console.log('Health archive folder: ' + DriveApp.getFolderById(props.getProperty('A2Z_HEALTH_ARCHIVE_FOLDER_ID')).getUrl());
  console.log('Copy the secret once into ERP .env as BOOKING_SYNC_SECRET. Do not put it in website files.');
}
function verifyWebsiteBackend() {
  const form = a2zForm_();
  console.log('Connected to: ' + form.getTitle());
  console.log('Form: ' + form.getEditUrl());
  console.log('Run configureErpIntegration once before enabling ERP pull or Drive archive.');
  console.log('Deploy > Manage deployments > Edit > New version. Execute as Me. Who has access: Anyone.');
}
function doGet(e) {
  try {
    if (e && e.parameter && e.parameter.admin === '1') return a2zAdminPage_();
    return a2zJson_({ok:true, service:'A2Z booking backend', version:3});
  }
  catch (error) { return a2zJson_({ok:false, error:String(error.message || error)}); }
}
function a2zJson_(value) { return ContentService.createTextOutput(JSON.stringify(value)).setMimeType(ContentService.MimeType.JSON); }
function a2zSyncSecret_() { const secret = PropertiesService.getScriptProperties().getProperty('A2Z_ERP_SYNC_SECRET') || ''; if (!secret) throw new Error('ERP sync is not configured.'); return secret; }
function a2zRequireSyncToken_(token) { if (!token || token !== a2zSyncSecret_()) throw new Error('Invalid ERP sync token.'); }
function a2zAckKey_(reference) { const bytes = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, String(reference), Utilities.Charset.UTF_8); return 'ERP_ACK_' + bytes.map(value => ('0' + ((value + 256) % 256).toString(16)).slice(-2)).join(''); }
function a2zEnglishTitle_(title) { const value = String(title || ''); const parts = value.split(' / '); return parts[parts.length - 1].trim(); }
function a2zFormValues_(response) { const values = {}; response.getItemResponses().forEach(itemResponse => { values[a2zEnglishTitle_(itemResponse.getItem().getTitle())] = itemResponse.getResponse(); }); return values; }
function a2zText_(value) { if (value instanceof Date) return Utilities.formatDate(value, 'Asia/Colombo', "yyyy-MM-dd'T'HH:mm:ssXXX"); if (Array.isArray(value)) return value.join(', '); return value === null || value === undefined ? '' : String(value).trim(); }
function a2zDeviceType_(serviceKey) { if (serviceKey === 'computers' || serviceKey === 'computer_health') return 'computer'; if (serviceKey === 'cctv' || serviceKey === 'cctv_health') return 'cctv'; if (serviceKey === 'printers') return 'printer'; return 'other'; }
function a2zNormalizeFormResponse_(response) { const value = a2zFormValues_(response); const serviceLabel = a2zText_(value['Required service']).replace(/^.* \/ /, ''); const serviceKey = A2Z_SERVICE_BY_LABEL[serviceLabel] || Object.keys(A2Z_SERVICES).find(key => serviceLabel.indexOf(A2Z_SERVICES[key]) >= 0) || ''; const category = serviceKey === 'installation' ? 'installation' : serviceKey.endsWith('_health') ? 'health_check' : 'repair'; const method = a2zText_(value['Service method']).replace(/^.* \/ /, ''); const mode = method.indexOf('home or business') >= 0 ? 'doorstep' : method.indexOf('workshop') >= 0 ? 'shop' : 'shop'; const additional = a2zText_(value['Additional information']); const websiteMatch = additional.match(/Website request:\s*([a-f0-9-]{36})/i); const combinedDevice = a2zText_(value['Device type and model']); const combinedModel = combinedDevice.match(/\s\|\sModel:\s*(.+)$/i); const details = [value['Describe the fault or help required'], value['Installation requirements'], value['Anything you would like checked?'], additional.replace(/\n?Website request:\s*[a-f0-9-]{36}/i, '').trim()].map(a2zText_).filter(Boolean).join('\n'); return {external_reference:response.getId(),website_request_id:websiteMatch?websiteMatch[1]:null,source:'google_form',customer_name:a2zText_(value['Your name']),customer_phone:a2zText_(value['Phone number']),customer_email:a2zText_(value['Email address']),address:a2zText_(value['Full service address']),service_category:category,service_mode:mode,preferred_start:a2zText_(value['Preferred date']),problem_description:details||A2Z_SERVICES[serviceKey]||serviceLabel,serial_number:a2zText_(value['Serial number']),device_type:a2zDeviceType_(serviceKey),device_brand:a2zText_(value['Device name or type']||combinedDevice.replace(/\s\|\sModel:\s*.+$/i,'')),device_model:a2zText_(value['Model number']||(combinedModel&&combinedModel[1])),form_response_id:response.getId(),form_submitted_at:response.getTimestamp().toISOString()}; }
function a2zPullForErp_(parameters) { a2zRequireSyncToken_(parameters.token); const limit=Math.max(1,Math.min(100,Number(parameters.limit||100))); const props=PropertiesService.getScriptProperties(); const responses=a2zForm_().getResponses().sort((a,b)=>a.getTimestamp()-b.getTimestamp()); const rows=[]; for(const response of responses){if(props.getProperty(a2zAckKey_(response.getId())))continue;rows.push(a2zNormalizeFormResponse_(response));if(rows.length>=limit)break;} return a2zJson_({ok:true,rows:rows,pending_returned:rows.length}); }
function a2zAcknowledge_(payload) { a2zRequireSyncToken_(payload.token); const references=Array.isArray(payload.external_references)?payload.external_references.slice(0,100):[]; const props=PropertiesService.getScriptProperties(); const now=Date.now(); references.forEach(reference=>{if(reference)props.setProperty(a2zAckKey_(reference),String(now));}); const all=props.getProperties(); Object.keys(all).filter(key=>key.indexOf('ERP_ACK_')===0).forEach(key=>{if(now-Number(all[key]||0)>180*86400000)props.deleteProperty(key);}); return a2zJson_({ok:true,acknowledged:references.filter(Boolean).length}); }
function a2zArchiveHealth_(payload) { a2zRequireSyncToken_(payload.token); const reportId=a2zText_(payload.report_id),customerId=a2zText_(payload.customer_id),serialNumber=a2zText_(payload.serial_number),sha256=a2zText_(payload.diagnostic_sha256).toLowerCase(); if(!/^[A-Za-z0-9_-]{3,40}$/.test(reportId)||!/^CUST-[A-Za-z0-9_-]+$/.test(customerId))throw new Error('Invalid report or customer ID.'); if(!serialNumber||serialNumber.length>180||!/^[a-f0-9]{64}$/.test(sha256))throw new Error('Invalid serial number or diagnostic hash.'); if(!payload.diagnostic||typeof payload.diagnostic!=='object'||Array.isArray(payload.diagnostic))throw new Error('Diagnostic JSON is required.'); const props=PropertiesService.getScriptProperties(),folderId=props.getProperty('A2Z_HEALTH_ARCHIVE_FOLDER_ID'); if(!folderId)throw new Error('Health archive folder is not configured.'); const archiveKey='ARCHIVE_'+reportId+'_'+sha256.substring(0,24),existingId=props.getProperty(archiveKey); if(existingId){const existing=DriveApp.getFileById(existingId);return a2zJson_({ok:true,duplicate:true,fileId:existing.getId(),fileUrl:existing.getUrl(),archivedAt:existing.getDateCreated().toISOString()});} const safeSerial=serialNumber.replace(/[^A-Za-z0-9_-]+/g,'-').substring(0,60); const fileName=reportId+'_'+customerId+'_'+safeSerial+'_'+sha256.substring(0,12)+'.json'; const archiveDocument={archive_version:1,report_id:reportId,customer_id:customerId,serial_number:serialNumber,diagnostic_sha256:sha256,diagnostic_version:payload.diagnostic_version||null,inspected_at:payload.inspected_at||null,archived_at:new Date().toISOString(),diagnostic:payload.diagnostic}; const blob=Utilities.newBlob(JSON.stringify(archiveDocument,null,2),'application/json',fileName); const file=DriveApp.getFolderById(folderId).createFile(blob); props.setProperty(archiveKey,file.getId()); return a2zJson_({ok:true,fileId:file.getId(),fileUrl:file.getUrl(),archivedAt:archiveDocument.archived_at}); }
function a2zValidate_(raw) { const p={}; for(const [key,value] of Object.entries(raw||{})){if(typeof value!=='string'||value.length>3000)throw new Error('Invalid field.');p[key]=value.trim();} if(p.website)throw new Error('Invalid request.'); if(!/^[a-f0-9-]{36}$/i.test(p.requestId||''))throw new Error('Invalid request ID.'); if(!A2Z_SERVICES[p.service])throw new Error('Select a service.'); for(const key of ['name','phone','email','address','method','contactTime'])if(!p[key])throw new Error('Complete the required fields.'); if(!/^(0\d{9}|\+?94\d{9})$/.test(p.phone)||!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(p.email))throw new Error('Check your phone number and email.'); if(!['ta','en'].includes(p.contactLanguage))throw new Error('Select a contact language.'); if(!['workshop','onsite','discuss'].includes(p.method)||!['Morning','Afternoon','Any time'].includes(p.contactTime))throw new Error('Select visit arrangements.'); if(p.consent!=='yes')throw new Error('Please accept the acknowledgement.'); const health=p.service.endsWith('_health'); if(p.service==='installation'){if(!/^[1-9]\d{0,2}$/.test(p.cameras||'')||!['Home','Shop or office','Other'].includes(p.premises)||!p.details||p.method!=='onsite')throw new Error('Complete the CCTV installation details.');}else if(health){if(!/^[1-9]\d{0,2}$/.test(p.quantity||'')||p.working!=='yes'||!p.serial)throw new Error('Confirm the working system and enter its serial number.');}else if(!p.device||!p.details||!p.serial)throw new Error('Enter the device, serial number, and fault details.'); if(p.date){const dt=new Date(p.date+'T12:00:00Z');if(!/^\d{4}-\d{2}-\d{2}$/.test(p.date)||isNaN(dt.getTime())||dt.toISOString().slice(0,10)!==p.date)throw new Error('Invalid date.');}return p; }
function a2zResponse_(form,p) { const items=form.getItems(); const find=title=>{const found=items.filter(item=>item.getTitle().endsWith(' / '+title));if(found.length!==1)throw new Error('Form question missing or duplicated: '+title);return found[0];};let response=form.createResponse();const text=(title,value)=>{if(!value)return;const item=find(title);const typed=item.getType()===FormApp.ItemType.PARAGRAPH_TEXT?item.asParagraphTextItem():item.asTextItem();response.withItemResponse(typed.createResponse(value));};const choice=(title,english,checkbox)=>{const item=checkbox?find(title).asCheckboxItem():find(title).asMultipleChoiceItem();const match=item.getChoices().map(choiceItem=>choiceItem.getValue()).find(value=>value===english||value.endsWith(' / '+english));if(!match)throw new Error('Form choice missing: '+title);response.withItemResponse(item.createResponse(checkbox?[match]:match));}; text('Your name',p.name);text('Phone number',p.phone);text('Email address',p.email);text('Full service address',p.address);text('Nearby landmark',p.landmark);choice('Preferred contact language',p.contactLanguage==='ta'?'Tamil':'English');choice('Required service',A2Z_SERVICES[p.service]);if(p.service==='installation'){text('Number of cameras required',p.cameras);choice('Type of premises',p.premises);text('Installation requirements',p.details);}else if(p.service.endsWith('_health')){text('Number of computers or CCTV systems to check',p.quantity);text('Device type and model',p.device+(p.model?' | Model: '+p.model:''));text('Serial number',p.serial);text('Anything you would like checked?',p.details);choice('Device operation','I confirm the device is currently working',true);}else{text('Device name or type',p.device);text('Model number',p.model);text('Serial number',p.serial);text('Describe the fault or help required',p.details);text('What have you already tried?',p.tried);} choice('Service method',{workshop:'I will visit the Paranthan workshop',onsite:'Service at my home or business',discuss:'Discuss by phone first'}[p.method]);choice('Convenient time to contact you',p.contactTime);if(p.date){const [year,month,day]=p.date.split('-').map(Number);response.withItemResponse(find('Preferred date').asDateItem().createResponse(new Date(year,month-1,day,12)));}text('Additional information',(p.additional||'')+'\nWebsite request: '+p.requestId);choice('Acknowledgement','I have read and agree to the above',true);return response; }
function a2zPublicBooking_(e) { let lock;try{if(!e||!e.postData||e.postData.length>24000)return a2zJson_({ok:false,error:'Invalid request.'});const p=a2zValidate_(e.parameter);lock=LockService.getScriptLock();if(!lock.tryLock(20000))return a2zJson_({ok:false,error:'Please retry shortly.'});const form=a2zForm_();const props=PropertiesService.getScriptProperties();const key='WEB_'+p.requestId;const previous=props.getProperty(key);if(previous){const record=JSON.parse(previous);if(record.id){const existingToken=record.token||props.getProperty(a2zRequestTokenKey_(p.requestId))||'';return a2zJson_({ok:true,requestId:p.requestId,token:existingToken});}const marker='Website request: '+p.requestId;const saved=form.getResponses(new Date(record.at-1000)).find(response=>response.getItemResponses().some(item=>String(item.getResponse()).includes(marker)));if(saved){const recoveredToken=a2zAllocateToken_(p.requestId);props.setProperty(key,JSON.stringify({at:record.at,id:saved.getId(),token:recoveredToken}));return a2zJson_({ok:true,requestId:p.requestId,token:recoveredToken});}return a2zJson_({ok:false,error:'Previous submission could not be confirmed. Please contact A2Z before sending another request.'});}const now=Date.now();const all=props.getProperties();let count=0;Object.keys(all).filter(keyName=>keyName.startsWith('WEB_')).forEach(keyName=>{if(now-JSON.parse(all[keyName]).at>7*86400000)props.deleteProperty(keyName);else count++;});if(count>=1000)return a2zJson_({ok:false,error:'Online booking is temporarily unavailable.'});const response=a2zResponse_(form,p);props.setProperty(key,JSON.stringify({at:now}));const saved=response.submit();const token=a2zAllocateToken_(p.requestId);props.setProperty(key,JSON.stringify({at:now,id:saved.getId(),token:token}));return a2zJson_({ok:true,requestId:p.requestId,token:token});}catch(error){return a2zJson_({ok:false,error:'Unable to confirm this request. Please check your details or contact A2Z.'});}finally{if(lock&&lock.hasLock())lock.releaseLock();}}
function doPost(e) { try { const contentType=e&&e.postData?String(e.postData.type||''):''; if(contentType.indexOf('application/json')>=0){const payload=JSON.parse(e.postData.contents||'{}');if(payload.action==='erp_pull')return a2zPullForErp_(payload);if(payload.action==='erp_ack')return a2zAcknowledge_(payload);if(payload.action==='archive_health_report')return a2zArchiveHealth_(payload);return a2zJson_({ok:false,error:'Unsupported integration action.'});} return a2zPublicBooking_(e);}catch(error){return a2zJson_({ok:false,error:String(error.message||error)});} }
